{
  "info": {
    "_postman_id": "16d48837-9171-49cf-9c87-9f8588a3f882",
    "name": "Online Bookstore Checkout API",
    "description": "Member 4 order API smoke requests. Uses the local seeded catalogue by default. The simulator never processes real payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "idempotencyKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "List books / stock",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/books" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('catalogue returns 200', () => pm.response.to.have.status(200));",
        "pm.test('books include id, price and stock', () => { const books = pm.response.json(); pm.expect(books.length).to.be.above(0); pm.expect(books[0]).to.have.all.keys('id','title','author','price','stock'); });"
      ] } }]
    },
    {
      "name": "Successful order",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));" ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('order is created', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.test('actual server order ID and confirmation are returned', () => { pm.expect(body.order_id).to.be.a('string').and.not.empty; pm.expect(body.status).to.eql('CONFIRMED'); pm.environment.set('orderId', body.order_id); });",
          "pm.test('server total reconciles with its components', () => { pm.expect(Math.abs(body.total - (body.subtotal + body.shipping + body.tax - body.discount))).to.be.below(0.01); pm.expect(body.items.reduce((n, item) => n + item.line_total, 0)).to.eql(body.subtotal); });"
        ] } }],
      "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [{\"book_id\": 1, \"quantity\": 1}],\n  \"customer\": {\n    \"name\": \"A Reader\", \"email\": \"reader@example.com\", \"phone\": \"\",\n    \"address_line\": \"1 Story Lane\", \"city\": \"Mysuru\", \"state\": \"Karnataka\",\n    \"postal_code\": \"570001\", \"country\": \"India\"\n  },\n  \"payment_scenario\": \"success\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" }
    },
    {
      "name": "Invalid request (missing customer details)",
      "request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\"items\":[{\"book_id\":1,\"quantity\":1}],\"customer\":{}}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('invalid input returns 400', () => pm.response.to.have.status(400));",
        "pm.test('error uses the documented JSON code', () => pm.expect(pm.response.json().detail.code).to.eql('validation_error'));"
      ] } }]
    },
    {
      "name": "Empty order",
      "request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\"items\":[],\"customer\":{\"name\":\"A Reader\",\"email\":\"reader@example.com\",\"address_line\":\"1 Story Lane\",\"city\":\"Mysuru\",\"state\":\"Karnataka\",\"postal_code\":\"570001\",\"country\":\"India\"}}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('empty order is rejected as invalid', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "Client submitted total is rejected",
      "request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\"items\":[{\"book_id\":1,\"quantity\":1}],\"customer\":{\"name\":\"A Reader\",\"email\":\"reader@example.com\",\"address_line\":\"1 Story Lane\",\"city\":\"Mysuru\",\"state\":\"Karnataka\",\"postal_code\":\"570001\",\"country\":\"India\"},\"total\":0.01}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('client total is rejected with 400', () => pm.response.to.have.status(400));",
        "pm.test('validation error is explicit', () => pm.expect(pm.response.json().detail.code).to.eql('validation_error'));"
      ] } }]
    },
    {
      "name": "Insufficient stock (book 3, request four copies)",
      "request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\"items\":[{\"book_id\":3,\"quantity\":4}],\"customer\":{\"name\":\"A Reader\",\"email\":\"reader@example.com\",\"address_line\":\"1 Story Lane\",\"city\":\"Mysuru\",\"state\":\"Karnataka\",\"postal_code\":\"570001\",\"country\":\"India\"}}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('insufficient stock returns 409', () => pm.response.to.have.status(409));",
        "pm.test('stock error identifies its condition', () => pm.expect(pm.response.json().detail.code).to.eql('insufficient_stock'));"
      ] } }]
    },
    {
      "name": "Payment simulator failure",
      "request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\"items\":[{\"book_id\":1,\"quantity\":1}],\"customer\":{\"name\":\"A Reader\",\"email\":\"reader@example.com\",\"address_line\":\"1 Story Lane\",\"city\":\"Mysuru\",\"state\":\"Karnataka\",\"postal_code\":\"570001\",\"country\":\"India\"},\"payment_scenario\":\"failure\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('declined payment returns 402', () => pm.response.to.have.status(402));",
        "pm.test('decline is not reported as a confirmed order', () => pm.expect(pm.response.json().detail.code).to.eql('payment_failed'));"
      ] } }]
    }
  ]
}
